{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remotion scene manifest",
  "type": "object",
  "required": ["title", "fps", "width", "height", "duration_frames", "artifact_receipts", "scenes"],
  "properties": {
    "title": {"type": "string"},
    "fps": {"type": "integer", "minimum": 24},
    "width": {"type": "integer"},
    "height": {"type": "integer"},
    "duration_frames": {"type": "integer", "minimum": 1},
    "artifact_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scenes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["index", "start_frame", "duration_frames", "visual_prompt", "narration", "music_cue", "human_face", "asset_path"], "properties": {
      "index": {"type": "integer", "minimum": 0},
      "start_frame": {"type": "integer", "minimum": 0},
      "duration_frames": {"type": "integer", "minimum": 1},
      "visual_prompt": {"type": "string"},
      "narration": {"type": "string"},
      "music_cue": {"type": "string"},
      "on_screen_text": {"type": "string"},
      "human_face": {"type": "boolean"},
      "asset_path": {"type": ["string", "null"]}
    }}}
  }
}
