{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-backed video script",
  "type": "object",
  "required": ["title", "fps", "width", "height", "scenes", "artifact_receipts"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "fps": {"type": "integer", "minimum": 24, "maximum": 60},
    "width": {"type": "integer", "minimum": 480},
    "height": {"type": "integer", "minimum": 480},
    "artifact_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}}
  },
  "$defs": {
    "scene": {
      "type": "object", "required": ["duration_seconds", "narration", "visual_prompt", "music_cue"],
      "properties": {
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "narration": {"type": "string", "minLength": 1},
        "visual_prompt": {"type": "string", "minLength": 1},
        "music_cue": {"type": "string"},
        "on_screen_text": {"type": "string"},
        "human_face": {"type": "boolean"}
      }
    }
  }
}
