{
  "name": "render",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@remotion/cli": "4.0.536",
    "music-metadata": "^12.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "prepare": "node scripts/prepare-media.mjs",
    "render:draft": "npm run prepare && remotion render src/index.ts LostCauseDraft out/001-ai-lost-cause-draft.mp4 --codec h264 --crf 24 --concurrency 4 --enforce-audio-track",
    "render": "npm run prepare && remotion render src/index.ts LostCauseDraft out/001-ai-lost-cause-assets-draft.mp4 --codec h264 --crf 24 --scale 0.5 --concurrency 2 --enforce-audio-track --log=error",
    "predev": "npm run prepare",
    "prelint": "npm run prepare",
    "prebuild": "npm run prepare"
  },
  "allowScripts": {
    "esbuild": false
  }
}
